{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "agentrouter": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "AgentRouter",
      "apiKey": "integrated-via-headers",
      "options": {
        "baseURL": "https://agentrouter.org",
